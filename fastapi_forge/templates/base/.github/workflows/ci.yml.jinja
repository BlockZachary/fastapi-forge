name: CI

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]

jobs:
  test:
    runs-on: ubuntu-latest

    {% if database_type != 'none' %}
    services:
      {% if database_type == 'postgres' %}
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_USER: test
          POSTGRES_PASSWORD: test
          POSTGRES_DB: test_db
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
      {% elif database_type == 'mysql' %}
      mysql:
        image: mysql:8.0
        env:
          MYSQL_ROOT_PASSWORD: test
          MYSQL_DATABASE: test_db
          MYSQL_USER: test
          MYSQL_PASSWORD: test
        ports:
          - 3306:3306
        options: >-
          --health-cmd "mysqladmin ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
      {% endif %}
      {% if use_redis %}
      redis:
        image: redis:7-alpine
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
      {% endif %}
    {% endif %}

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "{{ python_version }}"

      {% if use_uv %}
      - name: Install uv
        uses: astral-sh/setup-uv@v4
        with:
          version: "latest"

      - name: Install dependencies
        run: uv sync --group dev

      - name: Run linting
        run: uv run ruff check .

      - name: Run type checking
        run: uv run mypy app

      - name: Run tests
        run: uv run pytest -v --cov=app --cov-report=xml
        env:
          {% if database_type == 'postgres' %}
          DATABASE_URL: "postgresql+asyncpg://test:test@localhost:5432/test_db"
          {% elif database_type == 'mysql' %}
          DATABASE_URL: "mysql+asyncmy://test:test@localhost:3306/test_db"
          {% elif database_type == 'sqlite' %}
          DATABASE_URL: "sqlite+aiosqlite:///./test.db"
          {% endif %}
          {% if use_redis %}
          REDIS_URL: "redis://localhost:6379/0"
          {% endif %}
      {% elif use_poetry %}
      - name: Install Poetry
        uses: snok/install-poetry@v1
        with:
          virtualenvs-create: true
          virtualenvs-in-project: true

      - name: Install dependencies
        run: poetry install --with dev

      - name: Run linting
        run: poetry run ruff check .

      - name: Run type checking
        run: poetry run mypy app

      - name: Run tests
        run: poetry run pytest -v --cov=app --cov-report=xml
        env:
          {% if database_type == 'postgres' %}
          DATABASE_URL: "postgresql+asyncpg://test:test@localhost:5432/test_db"
          {% elif database_type == 'mysql' %}
          DATABASE_URL: "mysql+asyncmy://test:test@localhost:3306/test_db"
          {% elif database_type == 'sqlite' %}
          DATABASE_URL: "sqlite+aiosqlite:///./test.db"
          {% endif %}
          {% if use_redis %}
          REDIS_URL: "redis://localhost:6379/0"
          {% endif %}
      {% else %}
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install -r requirements-dev.txt

      - name: Run linting
        run: ruff check .

      - name: Run type checking
        run: mypy app

      - name: Run tests
        run: pytest -v --cov=app --cov-report=xml
        env:
          {% if database_type == 'postgres' %}
          DATABASE_URL: "postgresql+asyncpg://test:test@localhost:5432/test_db"
          {% elif database_type == 'mysql' %}
          DATABASE_URL: "mysql+asyncmy://test:test@localhost:3306/test_db"
          {% elif database_type == 'sqlite' %}
          DATABASE_URL: "sqlite+aiosqlite:///./test.db"
          {% endif %}
          {% if use_redis %}
          REDIS_URL: "redis://localhost:6379/0"
          {% endif %}
      {% endif %}

      - name: Upload coverage to Codecov
        uses: codecov/codecov-action@v4
        with:
          file: ./coverage.xml
          fail_ci_if_error: false
