"""
Environment Configuration Classes

This module defines Pydantic models for environment-specific configuration.
"""

from pydantic import BaseModel


class AppConfig(BaseModel):
    """Application configuration."""

    name: str
    description: str = ""
    api: str = "/api"
    host: str = "0.0.0.0"
    port: int = 8000
    uvicorn: str = "app.server:app"
    version: str = "0.1.0"
    reload: bool = True

{% if use_database %}

class DatabaseConfig(BaseModel):
    """Database configuration."""

    host: str
    port: int
    user: str
    password: str
    database: str
    driver_name: str = "postgresql+asyncpg"
    echo: bool = False
    pool_size: int = 5
    max_overflow: int = 10
    pool_recycle: int = 3600
    pool_timeout: int = 30

    @property
    def database_url(self) -> str:
        """Get the database URL."""
{% if use_sqlite %}
        if "sqlite" in self.driver_name:
            return f"{self.driver_name}:///{self.database}"
{% endif %}
        return f"{self.driver_name}://{self.user}:{self.password}@{self.host}:{self.port}/{self.database}"
{% endif %}

{% if use_redis %}

class RedisConfig(BaseModel):
    """Redis configuration."""

    host: str = "localhost"
    port: int = 6379
    db: int = 0
    password: str = ""

    @property
    def redis_url(self) -> str:
        """Get the Redis URL."""
        if self.password:
            return f"redis://:{self.password}@{self.host}:{self.port}/{self.db}"
        return f"redis://{self.host}:{self.port}/{self.db}"
{% endif %}

{% if use_auth %}

class JwtConfig(BaseModel):
    """JWT configuration."""

    secret_key: str
    algorithm: str = "HS256"
    expire_minutes: int = 1440
{% endif %}
